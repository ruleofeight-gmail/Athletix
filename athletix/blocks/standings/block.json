{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "athletix/standings",
	"title": "Athletix Standings",
	"category": "athletix",
	"icon": "list-view",
	"description": "League standings table for a league and optional season.",
	"textdomain": "athletix",
	"editorScript": "athletix-blocks",
	"style": "athletix",
	"editorStyle": "athletix",
	"supports": {
		"html": false
	},
	"attributes": {
		"league": {
			"type": "number",
			"default": 0
		},
		"season": {
			"type": "number",
			"default": 0
		}
	}
}
